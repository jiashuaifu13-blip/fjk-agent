# ============================================================
# FJK Agent - Git Attributes
# ============================================================

* text=auto

# Source code
*.go     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf

# Windows scripts
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.wav    binary
*.mp3    binary
*.ogg    binary
*.zip    binary
*.exe    binary
*.dll    binary
