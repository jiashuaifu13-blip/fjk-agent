# ============================================================
# FJK Agent - Environment Example
# Copy to .env for local development.
# Never commit real secrets.
# ============================================================

# Environment
FJK_ENV=development

# Local Agent Core
FJK_CORE_HOST=127.0.0.1
FJK_CORE_PORT=17890

# Database
FJK_DATABASE_PATH=./data/fjk-agent.db

# AI Provider
FJK_AI_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Logging
FJK_LOG_LEVEL=debug
